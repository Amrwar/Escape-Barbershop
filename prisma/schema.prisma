generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  /// Staff sign in with an email; customers with their phone number.
  email              String?             @unique
  phone              String?             @unique
  password           String
  name               String
  role               Role                @default(CASHIER)
  barberId           String?             @unique
  /// Set on a customer's own login, linking it to their record in the shop.
  customerId         String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  closedSessions     CashDrawerSession[] @relation("ClosedSessions")
  openedSessions     CashDrawerSession[] @relation("OpenedSessions")
  cashMovements      CashMovement[]      @relation("CreatedMovements")
  recordedVisits     Visit[]             @relation("RecordedVisits")
  bookedAppointments Appointment[]       @relation("BookedAppointments")
  writtenNotes       CustomerNote[]      @relation("WrittenNotes")
  barber             Barber?             @relation(fields: [barberId], references: [id])
  customer           Customer?           @relation(fields: [customerId], references: [id])
}

model Barber {
  id             String                @id @default(cuid())
  name           String
  phone          String?
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  /// Shown on the barber's public profile.
  bio            String?
  photo          String?
  /// Off for a barber who works the floor but takes no bookings.
  bookableOnline Boolean               @default(true)
  advances       Advance[]
  attendance     Attendance[]
  salarySettings BarberSalarySettings?
  penalties      Penalty[]
  user           User?
  visits         Visit[]
  appointments   Appointment[]
  customerNotes  CustomerNote[]
  workingHours   BarberWorkingHours[]
  timeOff        BarberTimeOff[]
  services       BarberService[]
}

/// The shop's normal opening hours, one row per weekday (0 = Sunday). A missing
/// row means the shop is shut that day. Times are minutes from midnight, shop time.
model ShopHours {
  weekday     Int     @id
  startMinute Int
  endMinute   Int
  isOpen      Boolean @default(true)
}

/// A barber's own hours, where they differ from the shop's. No rows at all means
/// the barber simply works the shop's hours.
model BarberWorkingHours {
  id          String  @id @default(cuid())
  barberId    String
  weekday     Int
  startMinute Int
  endMinute   Int
  isWorking   Boolean @default(true)
  barber      Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, weekday])
}

/// Holiday, sick day, or an hour out. Blocks booking for the whole span.
model BarberTimeOff {
  id        String   @id @default(cuid())
  barberId  String
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startAt])
}

/// Which barber does which service. A barber with no rows does everything, so
/// nothing has to be set up before booking works.
model BarberService {
  barberId  String
  serviceId String
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
}

/// A booked (or walked-in) appointment. It holds the chair; the money side stays
/// with Visit, which an appointment points at once it has been rung up.
model Appointment {
  id              String               @id @default(cuid())
  customerId      String
  /// Null while the customer has not been given a barber yet ("any barber").
  barberId        String?
  startAt         DateTime
  endAt           DateTime
  status          AppointmentStatus    @default(CONFIRMED)
  source          AppointmentSource    @default(ONLINE)
  notes           String?
  /// Snapshot of what was quoted at booking time, so a later price change
  /// never rewrites an old appointment.
  totalPrice      Float                @default(0)
  durationMinutes Int
  cancelledAt     DateTime?
  cancelReason    String?
  /// Set when the appointment is rung up. One visit per appointment.
  visitId         String?              @unique
  createdByUserId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  customer        Customer             @relation(fields: [customerId], references: [id])
  barber          Barber?              @relation(fields: [barberId], references: [id])
  createdBy       User?                @relation("BookedAppointments", fields: [createdByUserId], references: [id])
  visit           Visit?               @relation(fields: [visitId], references: [id])
  services        AppointmentService[]

  @@index([startAt])
  @@index([barberId, startAt])
  @@index([customerId, startAt])
  @@index([status, startAt])
}

/// One line of an appointment, with the name, price and length copied in as they
/// were when it was booked.
model AppointmentService {
  id              String      @id @default(cuid())
  appointmentId   String
  serviceId       String
  serviceName     String
  price           Float
  durationMinutes Int
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service         Service     @relation(fields: [serviceId], references: [id])
}

model Attendance {
  id        String   @id @default(cuid())
  barberId  String
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  barber    Barber   @relation(fields: [barberId], references: [id])

  @@unique([barberId, date])
}

model BarberSalarySettings {
  id              String         @id @default(cuid())
  barberId        String         @unique
  baseSalary      Float          @default(0)
  commissionType  CommissionType @default(PERCENT)
  commissionValue Float          @default(0)
  updatedAt       DateTime       @updatedAt
  barber          Barber         @relation(fields: [barberId], references: [id])
}

/// Who changed what, and when. The user name and role are copied in rather than
/// joined, so removing a staff account never erases the trail they left.
model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  userId   String?
  userName String
  userRole String
  action   String
  entity   String
  entityId String?
  summary  String
  amount   Float?
  details  String?

  @@index([at])
  @@index([entity, action])
  @@index([userId])
}

model Setting {
  key   String @id
  value String
}

model Service {
  id                    String               @id @default(cuid())
  name                  String               @unique
  defaultPrice          Float                @default(0)
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  arabicName            String?
  excludeFromCommission Boolean              @default(false)
  /// How long a chair is taken for. Booking is built on this.
  durationMinutes       Int                  @default(30)
  /// Off for anything a customer should not be able to book themselves.
  bookableOnline        Boolean              @default(true)
  visitItems            VisitItem[]
  barbers               BarberService[]
  appointmentServices   AppointmentService[]
}

/// What the barber should know before the customer sits down: "low fade, same
/// as last time". Kept apart from the shop's own notes on the customer record.
model CustomerNote {
  id              String   @id @default(cuid())
  customerId      String
  barberId        String?
  createdByUserId String?
  text            String
  createdAt       DateTime @default(now())
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  barber          Barber?  @relation(fields: [barberId], references: [id])
  createdBy       User?    @relation("WrittenNotes", fields: [createdByUserId], references: [id])

  @@index([customerId, createdAt])
}

model Customer {
  id           String         @id @default(cuid())
  name         String
  phone        String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  visits       Visit[]
  appointments Appointment[]
  user         User?
  notes_       CustomerNote[]
}

model Visit {
  id              String             @id @default(cuid())
  customerId      String
  barberId        String?
  visitAt         DateTime           @default(now())
  paymentMethod   PaymentMethod      @default(CASH)
  discount        Float              @default(0)
  total           Float
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  cardAmount      Float?
  cashAmount      Float?
  /// Paid by InstaPay transfer; lands in the bank, never in the drawer.
  instapayAmount  Float?
  tip             Float              @default(0)
  sessionId       String?
  sessionSequence Int?
  /// Who rang the visit up. Null on visits recorded before this was tracked.
  createdByUserId String?
  barber          Barber?            @relation(fields: [barberId], references: [id])
  createdBy       User?              @relation("RecordedVisits", fields: [createdByUserId], references: [id])
  appointment     Appointment?
  customer        Customer           @relation(fields: [customerId], references: [id])
  session         CashDrawerSession? @relation(fields: [sessionId], references: [id])
  items           VisitItem[]
  tipMovements    CashMovement[]
}

model CashDrawerSession {
  id                 String         @id @default(cuid())
  openedAt           DateTime       @default(now())
  closedAt           DateTime?
  openedByUserId     String
  closedByUserId     String?
  openingCash        Float
  closingCashCounted Float?
  notes              String?
  status             SessionStatus  @default(OPEN)
  closedBy           User?          @relation("ClosedSessions", fields: [closedByUserId], references: [id])
  openedBy           User           @relation("OpenedSessions", fields: [openedByUserId], references: [id])
  movements          CashMovement[]
  visits             Visit[]
}

model CashMovement {
  id              String            @id @default(cuid())
  sessionId       String
  type            MovementType
  amount          Float
  reason          String
  createdAt       DateTime          @default(now())
  createdByUserId String
  visitId         String?
  createdBy       User              @relation("CreatedMovements", fields: [createdByUserId], references: [id])
  session         CashDrawerSession @relation(fields: [sessionId], references: [id])
  visit           Visit?            @relation(fields: [visitId], references: [id])
}

model VisitItem {
  id          String   @id @default(cuid())
  visitId     String
  serviceId   String
  quantity    Int      @default(1)
  priceAtTime Float
  createdAt   DateTime @default(now())
  service     Service  @relation(fields: [serviceId], references: [id])
  visit       Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model Penalty {
  id        String   @id @default(cuid())
  barberId  String
  date      DateTime
  amount    Float
  reason    String
  createdAt DateTime @default(now())
  barber    Barber   @relation(fields: [barberId], references: [id])
}

model Expense {
  id            String    @id @default(cuid())
  date          DateTime
  amount        Float
  reason        String
  paymentMethod PayMethod @default(CASH)
  category      String?
  createdAt     DateTime  @default(now())

  purchaseInvoice PurchaseInvoice?
  supplierPayment SupplierPayment?
}

/// Salary advance paid to a barber (سلفة).
/// Cash advances leave the drawer, but an advance is NOT an operating expense:
/// it is recovered from the barber's payroll, so it never reduces daily revenue.
model Advance {
  id            String    @id @default(cuid())
  barberId      String
  date          DateTime
  amount        Float
  paymentMethod PayMethod @default(CASH)
  notes         String?
  createdAt     DateTime  @default(now())
  barber        Barber    @relation(fields: [barberId], references: [id])

  @@index([barberId, date])
}

model Product {
  id            String              @id @default(cuid())
  name          String              @unique
  unit          String              @default("pcs")
  costPrice     Float               @default(0)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  usages        ProductUsage[]
  purchaseItems PurchaseItem[]
  transferItems StockTransferItem[]
  countItems    StockCountItem[]
  movements     StockMovement[]
}

model Supplier {
  id        String            @id @default(cuid())
  name      String            @unique
  phone     String?
  notes     String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  invoices  PurchaseInvoice[]
  payments  SupplierPayment[]
}

/// Purchase invoice (فاتورة مشتريات) — always received into the MAIN store.
/// CASH/CARD invoices post an Expense immediately; CREDIT invoices post nothing
/// until the supplier is paid (SupplierPayment).
model PurchaseInvoice {
  id          String          @id @default(cuid())
  number      String?
  supplierId  String?
  date        DateTime
  paymentType PurchasePayment @default(CASH)
  total       Float           @default(0)
  notes       String?
  expenseId   String?         @unique
  createdAt   DateTime        @default(now())
  supplier    Supplier?       @relation(fields: [supplierId], references: [id])
  expense     Expense?        @relation(fields: [expenseId], references: [id])
  items       PurchaseItem[]
}

model PurchaseItem {
  id        String          @id @default(cuid())
  invoiceId String
  productId String
  quantity  Float
  unitCost  Float
  total     Float
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
}

/// Payment against a credit purchase account (سداد مورّد).
model SupplierPayment {
  id            String    @id @default(cuid())
  supplierId    String
  date          DateTime
  amount        Float
  paymentMethod PayMethod @default(CASH)
  notes         String?
  expenseId     String?   @unique
  createdAt     DateTime  @default(now())
  supplier      Supplier  @relation(fields: [supplierId], references: [id])
  expense       Expense?  @relation(fields: [expenseId], references: [id])
}

/// Issue note (إذن صرف) moving stock from the main store to the branch.
model StockTransfer {
  id           String              @id @default(cuid())
  number       String?
  date         DateTime
  fromLocation StockLocation       @default(MAIN)
  toLocation   StockLocation       @default(BRANCH)
  notes        String?
  createdAt    DateTime            @default(now())
  items        StockTransferItem[]
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  productId  String
  quantity   Float
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id])
}

/// Stocktake (جرد) — counted quantity vs. book quantity, per location.
model StockCount {
  id        String           @id @default(cuid())
  date      DateTime
  location  StockLocation    @default(BRANCH)
  notes     String?
  createdAt DateTime         @default(now())
  items     StockCountItem[]
}

model StockCountItem {
  id         String     @id @default(cuid())
  countId    String
  productId  String
  systemQty  Float
  countedQty Float
  unitCost   Float      @default(0)
  count      StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])
}

/// Single ledger every stock balance is derived from. Quantity is signed:
/// positive adds to the location, negative removes from it.
model StockMovement {
  id        String        @id @default(cuid())
  productId String
  date      DateTime
  location  StockLocation
  type      StockMoveType
  quantity  Float
  unitCost  Float         @default(0)
  refId     String?
  notes     String?
  createdAt DateTime      @default(now())
  product   Product       @relation(fields: [productId], references: [id])

  @@index([productId, location])
  @@index([refId])
  @@index([date])
}

model ProductUsage {
  id        String        @id @default(cuid())
  productId String
  quantity  Float
  location  StockLocation @default(BRANCH)
  date      DateTime
  notes     String?
  createdAt DateTime      @default(now())
  product   Product       @relation(fields: [productId], references: [id])
}

enum Role {
  OWNER
  CASHIER
  /// Their own schedule, their own customers, their own earnings. Nothing else.
  BARBER
  CUSTOMER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  /// Served, but left without paying. Closed, and counted nowhere as revenue.
  COMPLETED_UNPAID
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  PHONE
  WALK_IN
  STAFF
}

enum CommissionType {
  PERCENT
  FIXED_PER_VISIT
}

enum PaymentMethod {
  CASH
  CARD
  INSTAPAY
  MIXED
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum MovementType {
  IN
  OUT
}

enum PayMethod {
  CASH
  CARD
  INSTAPAY
}

enum PurchasePayment {
  CASH
  CARD
  CREDIT
}

enum StockLocation {
  MAIN
  BRANCH
}

enum StockMoveType {
  PURCHASE
  TRANSFER_IN
  TRANSFER_OUT
  USAGE
  ADJUSTMENT
  RETURN
}
