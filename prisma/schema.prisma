generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String              @id @default(cuid())
  email          String              @unique
  password       String
  name           String
  role           Role                @default(CASHIER)
  barberId       String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  closedSessions CashDrawerSession[] @relation("ClosedSessions")
  openedSessions CashDrawerSession[] @relation("OpenedSessions")
  cashMovements  CashMovement[]      @relation("CreatedMovements")
  barber         Barber?             @relation(fields: [barberId], references: [id])
}

model Barber {
  id             String                @id @default(cuid())
  name           String
  phone          String?
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  advances       Advance[]
  attendance     Attendance[]
  salarySettings BarberSalarySettings?
  penalties      Penalty[]
  user           User?
  visits         Visit[]
}

model Attendance {
  id        String   @id @default(cuid())
  barberId  String
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  barber    Barber   @relation(fields: [barberId], references: [id])

  @@unique([barberId, date])
}

model BarberSalarySettings {
  id              String         @id @default(cuid())
  barberId        String         @unique
  baseSalary      Float          @default(0)
  commissionType  CommissionType @default(PERCENT)
  commissionValue Float          @default(0)
  updatedAt       DateTime       @updatedAt
  barber          Barber         @relation(fields: [barberId], references: [id])
}

model Setting {
  key   String @id
  value String
}

model Service {
  id                    String      @id @default(cuid())
  name                  String      @unique
  defaultPrice          Float       @default(0)
  isActive              Boolean     @default(true)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  arabicName            String?
  excludeFromCommission Boolean     @default(false)
  visitItems            VisitItem[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visits    Visit[]
}

model Visit {
  id              String             @id @default(cuid())
  customerId      String
  barberId        String?
  visitAt         DateTime           @default(now())
  paymentMethod   PaymentMethod      @default(CASH)
  discount        Float              @default(0)
  total           Float
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  cardAmount      Float?
  cashAmount      Float?
  tip             Float              @default(0)
  sessionId       String?
  sessionSequence Int?
  barber          Barber?            @relation(fields: [barberId], references: [id])
  customer        Customer           @relation(fields: [customerId], references: [id])
  session         CashDrawerSession? @relation(fields: [sessionId], references: [id])
  items           VisitItem[]
  tipMovements    CashMovement[]
}

model CashDrawerSession {
  id                 String         @id @default(cuid())
  openedAt           DateTime       @default(now())
  closedAt           DateTime?
  openedByUserId     String
  closedByUserId     String?
  openingCash        Float
  closingCashCounted Float?
  notes              String?
  status             SessionStatus  @default(OPEN)
  closedBy           User?          @relation("ClosedSessions", fields: [closedByUserId], references: [id])
  openedBy           User           @relation("OpenedSessions", fields: [openedByUserId], references: [id])
  movements          CashMovement[]
  visits             Visit[]
}

model CashMovement {
  id              String            @id @default(cuid())
  sessionId       String
  type            MovementType
  amount          Float
  reason          String
  createdAt       DateTime          @default(now())
  createdByUserId String
  visitId         String?
  createdBy       User              @relation("CreatedMovements", fields: [createdByUserId], references: [id])
  session         CashDrawerSession @relation(fields: [sessionId], references: [id])
  visit           Visit?            @relation(fields: [visitId], references: [id])
}

model VisitItem {
  id          String   @id @default(cuid())
  visitId     String
  serviceId   String
  quantity    Int      @default(1)
  priceAtTime Float
  createdAt   DateTime @default(now())
  service     Service  @relation(fields: [serviceId], references: [id])
  visit       Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model Penalty {
  id        String   @id @default(cuid())
  barberId  String
  date      DateTime
  amount    Float
  reason    String
  createdAt DateTime @default(now())
  barber    Barber   @relation(fields: [barberId], references: [id])
}

model Expense {
  id            String    @id @default(cuid())
  date          DateTime
  amount        Float
  reason        String
  paymentMethod PayMethod @default(CASH)
  category      String?
  createdAt     DateTime  @default(now())

  purchaseInvoice PurchaseInvoice?
  supplierPayment SupplierPayment?
}

/// Salary advance paid to a barber (سلفة).
/// Cash advances leave the drawer, but an advance is NOT an operating expense:
/// it is recovered from the barber's payroll, so it never reduces daily revenue.
model Advance {
  id            String    @id @default(cuid())
  barberId      String
  date          DateTime
  amount        Float
  paymentMethod PayMethod @default(CASH)
  notes         String?
  createdAt     DateTime  @default(now())
  barber        Barber    @relation(fields: [barberId], references: [id])

  @@index([barberId, date])
}

model Product {
  id            String              @id @default(cuid())
  name          String              @unique
  unit          String              @default("pcs")
  costPrice     Float               @default(0)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  usages        ProductUsage[]
  purchaseItems PurchaseItem[]
  transferItems StockTransferItem[]
  countItems    StockCountItem[]
  movements     StockMovement[]
}

model Supplier {
  id        String            @id @default(cuid())
  name      String            @unique
  phone     String?
  notes     String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  invoices  PurchaseInvoice[]
  payments  SupplierPayment[]
}

/// Purchase invoice (فاتورة مشتريات) — always received into the MAIN store.
/// CASH/CARD invoices post an Expense immediately; CREDIT invoices post nothing
/// until the supplier is paid (SupplierPayment).
model PurchaseInvoice {
  id          String          @id @default(cuid())
  number      String?
  supplierId  String?
  date        DateTime
  paymentType PurchasePayment @default(CASH)
  total       Float           @default(0)
  notes       String?
  expenseId   String?         @unique
  createdAt   DateTime        @default(now())
  supplier    Supplier?       @relation(fields: [supplierId], references: [id])
  expense     Expense?        @relation(fields: [expenseId], references: [id])
  items       PurchaseItem[]
}

model PurchaseItem {
  id        String          @id @default(cuid())
  invoiceId String
  productId String
  quantity  Float
  unitCost  Float
  total     Float
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
}

/// Payment against a credit purchase account (سداد مورّد).
model SupplierPayment {
  id            String    @id @default(cuid())
  supplierId    String
  date          DateTime
  amount        Float
  paymentMethod PayMethod @default(CASH)
  notes         String?
  expenseId     String?   @unique
  createdAt     DateTime  @default(now())
  supplier      Supplier  @relation(fields: [supplierId], references: [id])
  expense       Expense?  @relation(fields: [expenseId], references: [id])
}

/// Issue note (إذن صرف) moving stock from the main store to the branch.
model StockTransfer {
  id           String              @id @default(cuid())
  number       String?
  date         DateTime
  fromLocation StockLocation       @default(MAIN)
  toLocation   StockLocation       @default(BRANCH)
  notes        String?
  createdAt    DateTime            @default(now())
  items        StockTransferItem[]
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  productId  String
  quantity   Float
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id])
}

/// Stocktake (جرد) — counted quantity vs. book quantity, per location.
model StockCount {
  id        String           @id @default(cuid())
  date      DateTime
  location  StockLocation    @default(BRANCH)
  notes     String?
  createdAt DateTime         @default(now())
  items     StockCountItem[]
}

model StockCountItem {
  id         String     @id @default(cuid())
  countId    String
  productId  String
  systemQty  Float
  countedQty Float
  unitCost   Float      @default(0)
  count      StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])
}

/// Single ledger every stock balance is derived from. Quantity is signed:
/// positive adds to the location, negative removes from it.
model StockMovement {
  id        String        @id @default(cuid())
  productId String
  date      DateTime
  location  StockLocation
  type      StockMoveType
  quantity  Float
  unitCost  Float         @default(0)
  refId     String?
  notes     String?
  createdAt DateTime      @default(now())
  product   Product       @relation(fields: [productId], references: [id])

  @@index([productId, location])
  @@index([refId])
  @@index([date])
}

model ProductUsage {
  id        String        @id @default(cuid())
  productId String
  quantity  Float
  location  StockLocation @default(BRANCH)
  date      DateTime
  notes     String?
  createdAt DateTime      @default(now())
  product   Product       @relation(fields: [productId], references: [id])
}

enum Role {
  OWNER
  CASHIER
}

enum CommissionType {
  PERCENT
  FIXED_PER_VISIT
}

enum PaymentMethod {
  CASH
  CARD
  MIXED
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum MovementType {
  IN
  OUT
}

enum PayMethod {
  CASH
  CARD
}

enum PurchasePayment {
  CASH
  CARD
  CREDIT
}

enum StockLocation {
  MAIN
  BRANCH
}

enum StockMoveType {
  PURCHASE
  TRANSFER_IN
  TRANSFER_OUT
  USAGE
  ADJUSTMENT
  RETURN
}
