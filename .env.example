# Database
# For local development with PostgreSQL:
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/barbershop_manager?schema=public"
# For Vercel Postgres (Neon/Vercel):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
# In production set to your domain: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# Notifications (web push)
# Protects the nightly reminder run: /api/cron/reminders refuses callers without it.
# CRON_SECRET="a-long-random-string"
# Where the push services can reach you if something is wrong with our messages.
# PUSH_CONTACT="mailto:you@yourshop.com"
# The notification key pair. Leave unset and the app makes one on first use.
# PUSH_PUBLIC_KEY=""
# PUSH_PRIVATE_KEY=""

# Notifications (the phone app, through Expo's push service)
# Only needed if push security is turned on for the app's EAS project.
# EXPO_ACCESS_TOKEN=""

# Default owner account created by seed
# SEED_OWNER_EMAIL="owner@barbershop.com"
# SEED_OWNER_PASSWORD="changeme123"
